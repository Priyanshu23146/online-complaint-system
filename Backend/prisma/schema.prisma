generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  DEPT_ADMIN
  STAFF
  MEMBER
}

enum NoticeVisibility {
  ORG_PUBLIC        // poore organization ko dikhega
  DEPT_PUBLIC       // us department ke sabhi logon ko
  STAFF_ONLY        // sirf us dept ke STAFF + DEPT_ADMIN ko
  DEPT_ADMIN_ONLY   // sirf us dept ke DEPT_ADMIN ko
}

model Organization {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  domain         String?        @unique
  createdAt      DateTime       @default(now())
  
  users          User[]
  departments    Department[]
  subscriptions  Subscription[]
  notices        Notice[]
}

model Subscription {
  id             Int          @id @default(autoincrement())
  plan           String       @default("FREE")
  status         String       @default("ACTIVE")
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Department {
  id             Int          @id @default(autoincrement())
  name           String
  organizationId Int
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  complaints     Complaint[]
  notices   Notice[]
  schedules      Schedule[]   // 🚀 Added for Timetables/Rosters
}

model User {
  id                 Int          @id @default(autoincrement())
  name               String
  email              String       @unique
  password           String
  role               Role         @default(MEMBER)
  mustChangePassword Boolean      @default(false)
  
  organizationId     Int
  departmentId       Int?
  
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department         Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  
  complaints         Complaint[]
  comments           Comment[]
  
  // 🚀 Added for Attendance & Scheduling
  managedSchedules   Schedule[]   @relation("ManagerSchedules")
  attendances        Attendance[]

  notices       Notice[] @relation("NoticeAuthor")
  createdAt DateTime @default(now())
}

model Complaint {
  id           Int        @id @default(autoincrement())
  title        String
  description  String
  status       String     @default("Pending")
  upvotes      Int        @default(0)
  createdAt    DateTime   @default(now())
  
  userId       Int
  departmentId Int
  
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  comments     Comment[]
}

model Comment {
  id          Int       @id @default(autoincrement())
  text        String
  createdAt   DateTime  @default(now())
  
  userId      Int
  complaintId Int
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

// 🚀 NEW: Universal Schedule Model (Classes, Shifts, Duties)
model Schedule {
  id             Int          @id @default(autoincrement())
  title          String       // e.g., "Java Lecture", "Morning ICU Shift"
  startTime      DateTime
  endTime        DateTime
  
  departmentId   Int
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  
  managerId      Int          // Teacher, Head Nurse, Team Lead
  manager        User         @relation("ManagerSchedules", fields: [managerId], references: [id], onDelete: Cascade)
  
  attendances    Attendance[]
}

// 🚀 NEW: Universal Attendance Model
model Attendance {
  id             Int        @id @default(autoincrement())
  status         String     // "PRESENT", "ABSENT", "LATE"
  markedAt       DateTime   @default(now())
  
  scheduleId     Int
  schedule       Schedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  
  userId         Int        // Student, Staff, Employee
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, userId]) // Prevents duplicate attendance for the same user in one shift/class
}

// 🚀 NEW: Notice Board with visibility scoping
model Notice {
  id             Int              @id @default(autoincrement())
  title          String
  content        String
  visibility     NoticeVisibility @default(ORG_PUBLIC)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organizationId Int
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // null = organization-wide notice (ORG_PUBLIC ke liye)
  departmentId   Int?
  department     Department?      @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdById    Int
  createdBy      User             @relation("NoticeAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  // Query performance: har read query in teeno columns pe filter karti hai
  @@index([organizationId, visibility])
  @@index([departmentId, visibility])
}