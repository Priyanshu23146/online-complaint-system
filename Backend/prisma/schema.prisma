generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  domain        String?        @unique // e.g., "@aitd.edu" to auto-assign users
  createdAt     DateTime       @default(now())
  
  users         User[]
  departments   Department[]
  subscriptions Subscription[]
}

model Subscription {
  id             Int          @id @default(autoincrement())
  plan           String       @default("FREE") // PRO, ENTERPRISE
  status         String       @default("ACTIVE") // PAST_DUE, CANCELED
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Department {
  id             Int          @id @default(autoincrement())
  name           String
  organizationId Int
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  users          User[]
  complaints     Complaint[]
}

model User {
  id                 Int          @id @default(autoincrement())
  name               String
  email              String       @unique
  password           String
  role               String       @default("STUDENT") // ORG_ADMIN, DEPT_ADMIN
  mustChangePassword Boolean      @default(false)
  
  organizationId     Int
  departmentId       Int?
  
  organization       Organization @relation(fields: [organizationId], references: [id])
  department         Department?  @relation(fields: [departmentId], references: [id])
  complaints         Complaint[]
  comments           Comment[]
}

model Complaint {
  id           Int          @id @default(autoincrement())
  title        String
  description  String
  status       String       @default("Pending")
  upvotes      Int          @default(0)
  createdAt    DateTime     @default(now())
  
  userId       Int
  departmentId Int
  
  user         User         @relation(fields: [userId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  comments     Comment[]
}

model Comment {
  id          Int       @id @default(autoincrement())
  text        String
  createdAt   DateTime  @default(now())
  
  userId      Int
  complaintId Int
  
  user        User      @relation(fields: [userId], references: [id])
  complaint   Complaint @relation(fields: [complaintId], references: [id])
}